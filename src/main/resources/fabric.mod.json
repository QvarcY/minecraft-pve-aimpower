  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.qvarcy.pveaimpower.client.PveAimPowerClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
